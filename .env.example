# Firebase Admin (server only — never expose these to the browser)
#
# From Firebase Console → Project settings → Service accounts →
# "Generate new private key". Map the JSON fields as follows:
#
#   project_id     → FIREBASE_ADMIN_PROJECT_ID
#   client_email   → FIREBASE_ADMIN_CLIENT_EMAIL
#   private_key    → FIREBASE_ADMIN_PRIVATE_KEY  (keep \n escapes in quotes)
#
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Demo passenger context (optional; defaults to demo-passenger in code)
DEMO_PASSENGER_ID=demo-passenger

# Public site URL (used for sitemap, Open Graph, canonical links)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
