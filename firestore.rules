rules_version = '2';

// ClaimDesk uses Firebase Admin SDK on the Next.js server only.
// There is no client Firebase SDK — browsers never talk to Firestore.
// Deny all client access; Admin SDK bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
